{
  "name": "calorie-ai-tracker",
  "version": "1.0.0",
  "private": true,
  "description": "AI calorie tracker that runs in your browser: log meals by text, photo or voice, follow your week against your goals, ask an AI coach.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p .",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "bun test src",
    "test:e2e": "bun run build && playwright test",
    "catalog": "llm-models catalog --npm callable --require openai,anthropic,google,mistral --out public/models.json"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "4.0.87",
    "@ai-sdk/google": "4.0.104",
    "@ai-sdk/mistral": "4.0.71",
    "@ai-sdk/openai": "4.0.101",
    "@ai-sdk/openai-compatible": "3.0.77",
    "ai": "7.0.152",
    "idb": "8.0.4",
    "llm-connect": "2.4.1",
    "llm-models": "1.13.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.2",
    "@playwright/test": "1.64.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/bun": "1.4.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  }
}
